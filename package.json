{
  "name": "filimonov-family-wishes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/build-worker.mjs && node --import tsx --test tests/*.test.ts",
    "deploy": "node scripts/preflight.mjs && wrangler d1 migrations apply family-wishes --remote && wrangler deploy",
    "check": "pnpm test && pnpm build",
    "db:local": "wrangler d1 migrations apply family-wishes --local",
    "db:remote": "wrangler d1 migrations apply family-wishes --remote",
    "deploy:api": "wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "^1.61.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20251011.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
